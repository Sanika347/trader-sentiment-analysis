import pandas as pd
import matplotlib.pyplot as plt

# ===============================
# Load Data
# ===============================

trades = pd.read_csv("/content/historical_data.csv")
sentiment = pd.read_csv("/content/fear_greed_index.csv")

print("Trades:", trades.shape)
print("Sentiment:", sentiment.shape)

# ===============================
# Data Cleaning
# ===============================

# Convert timestamps
trades["Timestamp IST"] = pd.to_datetime(trades["Timestamp IST"], errors="coerce")

sentiment["timestamp"] = pd.to_datetime(
sentiment["timestamp"], unit="s", errors="coerce"
)

# Extract date
trades["date"] = trades["Timestamp IST"].dt.date
sentiment["date"] = sentiment["timestamp"].dt.date

# Remove null dates
trades = trades.dropna(subset=["date"])
sentiment = sentiment.dropna(subset=["date"])

# Debugging: Print date ranges before merge
print(f"\nTrades date range: {trades['date'].min()} to {trades['date'].max()}")
print(f"Sentiment date range: {sentiment['date'].min()} to {sentiment['date'].max()}")

# Merge
merged = pd.merge(trades, sentiment, on="date", how="inner")

print("Merged:", merged.shape)

# Rename columns
merged = merged.rename(columns={
"Closed PnL": "pnl",
"Size USD": "size",
"Direction": "direction",
"classification": "sentiment"
})

# Convert numeric
merged["pnl"] = pd.to_numeric(merged["pnl"], errors="coerce")
merged["size"] = pd.to_numeric(merged["size"], errors="coerce")

merged = merged.dropna(subset=["pnl"])

# Win/Loss
merged["win"] = merged["pnl"] > 0


# ===============================
# Part A — Metrics
# ===============================

# Daily PnL per account
daily_pnl = merged.groupby(["date", "Account"])["pnl"].sum()

# Trades per day
trades_per_day = merged.groupby("date").size()

# Long/Short ratio
ls_ratio = merged["direction"].value_counts(normalize=True)

# Win rate per trader
win_rate = merged.groupby("Account")["win"].mean()


# ===============================
# Part B — Analysis
# ===============================

# Performance by sentiment
perf = merged.groupby("sentiment").agg(
    avg_pnl=("pnl", "mean"),
    median_pnl=("pnl", "median"),
    win_rate=("win", "mean"),
    trades=("Account", "count")
)

print("\nPerformance by Sentiment")
print(perf)


# Behavior analysis
behavior = merged.groupby("sentiment").agg(
    avg_size=("size", "mean"),
    trades=("Account", "count")
)

print("\nBehavior")
print(behavior)


# ===============================
# Segmentation
# ===============================

# Frequent vs Infrequent
trade_count = merged.groupby("Account").size()
median_trades = trade_count.median()

merged["freq_group"] = merged["Account"].map(
    lambda x: "Frequent" if trade_count[x] >= median_trades else "Infrequent"
)


# Winners vs Losers
total_pnl = merged.groupby("Account")["pnl"].sum()

merged["pnl_group"] = merged["Account"].map(
    lambda x: "Winner" if total_pnl[x] > 0 else "Loser"
)


segment = merged.groupby(
    ["freq_group", "pnl_group", "sentiment"]
).agg(
    avg_pnl=("pnl", "mean"),
    win_rate=("win", "mean"),
    trades=("Account", "count")
)

print("\nSegment Summary")
print(segment.head())


# ===============================
# Charts (Matplotlib only)
# ===============================

# 1. Avg PnL vs Sentiment
plt.figure()
perf["avg_pnl"].plot(kind="bar")
plt.title("Average PnL by Sentiment")
plt.xlabel("Sentiment")
plt.ylabel("Average PnL")
plt.tight_layout()
plt.savefig("avg_pnl.png")
plt.close()


# 2. Win Rate vs Sentiment
plt.figure()
perf["win_rate"].plot(kind="bar")
plt.title("Win Rate by Sentiment")
plt.xlabel("Sentiment")
plt.ylabel("Win Rate")
plt.tight_layout()
plt.savefig("win_rate.png")
plt.close()


# 3. Trades per Day
plt.figure()
trades_per_day.plot()
plt.title("Trades Per Day")
plt.xlabel("Date")
plt.ylabel("Trades")
plt.tight_layout()
plt.savefig("trades_per_day.png")
plt.close()


# ===============================
# Save Tables
# ===============================

perf.to_csv("performance.csv")
segment.to_csv("segments.csv")
daily_pnl.to_csv("daily_pnl.csv")


print("\nFiles Saved:")
print("avg_pnl.png")
print("win_rate.png")
print("trades_per_day.png")
print("performance.csv")
print("segments.csv")
print("daily_pnl.csv")
